{
  "name": "nhaikanji",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -H 127.0.0.1",
    "build": "prisma generate && next build",
    "start": "next start -H 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts src/features/social/social-store.test.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:local": "tsx prisma/local-postgres.ts",
    "db:setup": "tsx prisma/setup-local.ts",
    "db:test": "tsx tests/backend-integration.ts",
    "qa:routes": "node scripts/qa-routes.mjs",
    "qa:lessons": "node src/features/lessons/tools/qa.mjs && node src/features/lessons/tools/qa-integration.mjs",
    "qa:study": "tsx src/features/study/qa-study.mjs",
    "qa:social": "node scripts/qa-social-flows.mjs",
    "qa:account": "tsx tests/account-database.ts && tsx tests/account-integration.ts && tsx tests/account-app.ts",
    "qa:youtube": "YOUTUBE_BROWSER_QA=1 tsx --test tests/youtube.test.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.10.0",
    "@prisma/client": "^6.19.0",
    "@tanstack/react-query": "^5.85.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "15.5.29",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "^4.3.0",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.5.0",
    "radix-ui": "^1.4.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "wanakana": "^5.3.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.21",
    "embedded-postgres": "16.15.0-beta.19",
    "lighthouse": "^13.6.0",
    "postcss": "^8.5.33",
    "prisma": "^6.19.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "^8.0.2"
    },
    "next-auth": {
      "nodemailer": "$nodemailer"
    },
    "@auth/core": {
      "nodemailer": "$nodemailer"
    },
    "postcss": "$postcss"
  }
}
